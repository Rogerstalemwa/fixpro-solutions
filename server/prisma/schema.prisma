// FixPro Solutions - database schema (PostgreSQL + Prisma)
// Based on the Database Schema and API Specification v1.0. Money is DECIMAL(18,2), UGX.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Enumerations ─────────

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserRole {
  CUSTOMER
  COMPANY_TECHNICIAN
  INDEPENDENT_TECHNICIAN
  OPERATIONS_ADMIN
  TECHNICAL_SUPERVISOR
  FINANCE_ADMIN
  WORKSHOP_MANAGER
  LOGISTICS_PERSONNEL
  CORPORATE_USER
  SUPER_ADMIN
}

enum TechnicianVerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum FulfilmentMethod {
  DOORSTEP
  WORKSHOP
  COLLECTION_DELIVERY
}

enum BookingStatus {
  NEW_REQUEST
  UNDER_REVIEW
  AWAITING_ASSIGNMENT
  TECHNICIAN_ASSIGNED
  ACCEPTED
  APPOINTMENT_CONFIRMED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  CANCELLED
  DISPUTED
}

enum JobStatus {
  CREATED
  AWAITING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  APPOINTMENT_CONFIRMED
  TECHNICIAN_EN_ROUTE
  INSPECTION
  AWAITING_APPROVAL
  APPROVED
  IN_PROGRESS
  WORKSHOP_TRANSFER
  WORKSHOP_REPAIR
  QUALITY_CHECK
  READY_FOR_HANDOVER
  COMPLETED
  CANCELLED
  DISPUTED
}

enum AssignmentStatus {
  OFFERED
  ACCEPTED
  DECLINED
  WITHDRAWN
  COMPLETED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  REVISION_REQUESTED
  EXPIRED
  SUPERSEDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum WorkshopStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum LogisticsStatus {
  CREATED
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  COLLECTED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE
  JOB_USAGE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOIDED
  CLAIMED
}

// ───────── Authentication and users ─────────

model User {
  id            String               @id @default(uuid()) @db.Uuid
  fullName      String               @map("full_name")
  email         String?              @unique
  phone         String               @unique
  passwordHash  String               @map("password_hash")
  status        AccountStatus        @default(PENDING)
  lastLoginAt   DateTime?            @map("last_login_at") @db.Timestamptz
  roles         UserRoleAssignment[]
  customer      Customer?
  technician    Technician?
  notifications Notification[]
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @unique
  description String?
  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRoleAssignment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ───────── Customers ─────────

model Customer {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @unique @map("user_id") @db.Uuid
  customerType String            @default("INDIVIDUAL") @map("customer_type")
  user         User              @relation(fields: [userId], references: [id])
  addresses    CustomerAddress[]
  devices      Device[]
  bookings     Booking[]
  invoices     Invoice[]
  warranties   Warranty[]
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("customers")
}

model CustomerAddress {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  district     String
  town         String?
  area         String?
  street       String?
  landmark     String?
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  addressNotes String?   @map("address_notes")
  isDefault    Boolean   @default(false) @map("is_default")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  customer     Customer  @relation(fields: [customerId], references: [id])
  bookings     Booking[]
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([customerId])
  @@map("customer_addresses")
}

model Device {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  category     String
  brand        String?
  model        String?
  serialNumber String?   @map("serial_number")
  description  String?
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  customer     Customer  @relation(fields: [customerId], references: [id])
  bookings     Booking[]
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([customerId])
  @@map("devices")
}

// ───────── Service catalogue ─────────

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  services    Service[]
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("service_categories")
}

model Service {
  id               String                     @id @default(uuid()) @db.Uuid
  categoryId       String                     @map("category_id") @db.Uuid
  name             String
  description      String?
  diagnosticFee    Decimal?                   @map("diagnostic_fee") @db.Decimal(18, 2)
  indicativePrice  Decimal?                   @map("indicative_price") @db.Decimal(18, 2)
  pricingMethod    String                     @default("QUOTED") @map("pricing_method")
  estimatedMinutes Int?                       @map("estimated_minutes")
  active           Boolean                    @default(true)
  category         ServiceCategory            @relation(fields: [categoryId], references: [id])
  bookings         Booking[]
  specialisations  TechnicianSpecialisation[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("services")
}

// ───────── Technicians ─────────

model Technician {
  id                 String                       @id @default(uuid()) @db.Uuid
  userId             String                       @unique @map("user_id") @db.Uuid
  technicianType     String                       @map("technician_type") // COMPANY | INDEPENDENT
  verificationStatus TechnicianVerificationStatus @default(NOT_SUBMITTED) @map("verification_status")
  experienceSummary  String?                      @map("experience_summary")
  available          Boolean                      @default(false)
  photoUrl           String?                      @map("photo_url")
  ninHash            String?                      @unique @map("nin_hash")
  ninEncrypted       String?                      @map("nin_encrypted")
  ninLast4           String?                      @map("nin_last4")
  dateOfBirth        DateTime?                    @map("date_of_birth") @db.Date
  residenceDistrict  String?                      @map("residence_district")
  residenceTown      String?                      @map("residence_town")
  residenceAddress   String?                      @map("residence_address")
  nextOfKinName      String?                      @map("next_of_kin_name")
  nextOfKinPhone     String?                      @map("next_of_kin_phone")
  user               User                         @relation(fields: [userId], references: [id])
  specialisations    TechnicianSpecialisation[]
  coverageAreas      TechnicianCoverageArea[]
  documents          TechnicianDocument[]
  assignments        JobAssignment[]
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz

  @@map("technicians")
}

model TechnicianSpecialisation {
  id           String     @id @default(uuid()) @db.Uuid
  technicianId String     @map("technician_id") @db.Uuid
  serviceId    String     @map("service_id") @db.Uuid
  proficiency  String?
  technician   Technician @relation(fields: [technicianId], references: [id])
  service      Service    @relation(fields: [serviceId], references: [id])

  @@unique([technicianId, serviceId])
  @@map("technician_specialisations")
}

model TechnicianCoverageArea {
  id              String     @id @default(uuid()) @db.Uuid
  technicianId    String     @map("technician_id") @db.Uuid
  district        String
  town            String?
  maximumDistance Int?       @map("maximum_distance")
  active          Boolean    @default(true)
  technician      Technician @relation(fields: [technicianId], references: [id])

  @@index([district, town])
  @@map("technician_coverage_areas")
}

model TechnicianDocument {
  id                 String     @id @default(uuid()) @db.Uuid
  technicianId       String     @map("technician_id") @db.Uuid
  documentType       String     @map("document_type")
  fileReference      String     @map("file_reference")
  verificationStatus String     @default("PENDING") @map("verification_status")
  expiryDate         DateTime?  @map("expiry_date") @db.Timestamptz
  technician         Technician @relation(fields: [technicianId], references: [id])
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@map("technician_documents")
}

// ───────── Bookings and jobs ─────────

model Booking {
  id               String              @id @default(uuid()) @db.Uuid
  reference        String              @unique
  customerId       String              @map("customer_id") @db.Uuid
  deviceId         String              @map("device_id") @db.Uuid
  serviceId        String              @map("service_id") @db.Uuid
  addressId        String              @map("address_id") @db.Uuid
  fulfilmentMethod FulfilmentMethod    @map("fulfilment_method")
  faultDescription String              @map("fault_description")
  preferredDate    DateTime?           @map("preferred_date") @db.Timestamptz
  preferredTime    String?             @map("preferred_time")
  status           BookingStatus       @default(NEW_REQUEST)
  cancelReason     String?             @map("cancel_reason")
  customer         Customer            @relation(fields: [customerId], references: [id])
  device           Device              @relation(fields: [deviceId], references: [id])
  service          Service             @relation(fields: [serviceId], references: [id])
  address          CustomerAddress     @relation(fields: [addressId], references: [id])
  jobs             Job[]
  attachments      BookingAttachment[]
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@index([customerId, createdAt])
  @@index([status])
  @@map("bookings")
}

model BookingAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  fileReference String   @map("file_reference")
  fileType      String?  @map("file_type")
  booking       Booking  @relation(fields: [bookingId], references: [id])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("booking_attachments")
}

model Job {
  id                 String             @id @default(uuid()) @db.Uuid
  bookingId          String             @map("booking_id") @db.Uuid
  status             JobStatus          @default(CREATED)
  priority           String             @default("NORMAL")
  scheduledFor       DateTime?          @map("scheduled_for") @db.Timestamptz
  scheduledWindow    String?            @map("scheduled_window")
  assignedWorkshopId String?            @map("assigned_workshop_id") @db.Uuid
  booking            Booking            @relation(fields: [bookingId], references: [id])
  workshop           Workshop?          @relation(fields: [assignedWorkshopId], references: [id])
  assignments        JobAssignment[]
  statusHistory      JobStatusHistory[]
  quotations         Quotation[]
  inspections        Inspection[]
  serviceReports     ServiceReport[]
  invoices           Invoice[]
  warranties         Warranty[]
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@map("jobs")
}

model JobAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  jobId          String           @map("job_id") @db.Uuid
  technicianId   String           @map("technician_id") @db.Uuid
  assignedById   String           @map("assigned_by_id") @db.Uuid
  status         AssignmentStatus @default(OFFERED)
  declinedReason String?          @map("declined_reason")
  assignedAt     DateTime         @default(now()) @map("assigned_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  job            Job              @relation(fields: [jobId], references: [id])
  technician     Technician       @relation(fields: [technicianId], references: [id])

  @@index([technicianId, status])
  @@index([jobId])
  @@map("job_assignments")
}

model JobStatusHistory {
  id             String   @id @default(uuid()) @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  changedById    String   @map("changed_by_id") @db.Uuid
  notes          String?
  job            Job      @relation(fields: [jobId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId, createdAt])
  @@map("job_status_history")
}

// ───────── Inspection and reporting ─────────

model Inspection {
  id                String   @id @default(uuid()) @db.Uuid
  jobId             String   @map("job_id") @db.Uuid
  technicianId      String   @map("technician_id") @db.Uuid
  reportedSymptoms  String   @map("reported_symptoms")
  findings          String
  recommendedAction String   @map("recommended_action")
  estimatedWork     String?  @map("estimated_work")
  job               Job      @relation(fields: [jobId], references: [id])
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("inspections")
}

model ServiceReport {
  id              String   @id @default(uuid()) @db.Uuid
  jobId           String   @map("job_id") @db.Uuid
  technicianId    String   @map("technician_id") @db.Uuid
  workPerformed   String   @map("work_performed")
  partsReplaced   String?  @map("parts_replaced")
  testResults     String?  @map("test_results")
  recommendations String?
  job             Job      @relation(fields: [jobId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("service_reports")
}

// ───────── Quotations ─────────

model Quotation {
  id           String          @id @default(uuid()) @db.Uuid
  reference    String          @unique
  jobId        String          @map("job_id") @db.Uuid
  version      Int             @default(1)
  subtotal     Decimal         @db.Decimal(18, 2)
  discount     Decimal         @default(0) @db.Decimal(18, 2)
  tax          Decimal         @default(0) @db.Decimal(18, 2)
  total        Decimal         @db.Decimal(18, 2)
  status       QuotationStatus @default(DRAFT)
  preparedById String          @map("prepared_by_id") @db.Uuid
  approvedById String?         @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?       @map("approved_at") @db.Timestamptz
  expiresAt    DateTime?       @map("expires_at") @db.Timestamptz
  revisionNote String?         @map("revision_note")
  job          Job             @relation(fields: [jobId], references: [id])
  items        QuotationItem[]
  invoices     Invoice[]
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@unique([jobId, version])
  @@index([jobId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @map("quotation_id") @db.Uuid
  description String
  itemType    String    @map("item_type") // PART | LABOUR | FEE
  quantity    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(18, 2)
  totalPrice  Decimal   @map("total_price") @db.Decimal(18, 2)
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  @@map("quotation_items")
}

// ───────── Finance ─────────

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  reference   String        @unique
  customerId  String        @map("customer_id") @db.Uuid
  jobId       String        @map("job_id") @db.Uuid
  quotationId String?       @map("quotation_id") @db.Uuid
  subtotal    Decimal       @db.Decimal(18, 2)
  tax         Decimal       @default(0) @db.Decimal(18, 2)
  total       Decimal       @db.Decimal(18, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  balance     Decimal       @db.Decimal(18, 2)
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?     @map("issued_at") @db.Timestamptz
  dueAt       DateTime?     @map("due_at") @db.Timestamptz
  customer    Customer      @relation(fields: [customerId], references: [id])
  job         Job           @relation(fields: [jobId], references: [id])
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([customerId])
  @@index([jobId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(18, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id                        String        @id @default(uuid()) @db.Uuid
  invoiceId                 String        @map("invoice_id") @db.Uuid
  paymentReference          String        @unique @map("payment_reference")
  provider                  String
  providerTransactionId     String?       @map("provider_transaction_id")
  amount                    Decimal       @db.Decimal(18, 2)
  currency                  String        @default("UGX")
  status                    PaymentStatus @default(PENDING)
  paymentMethod             String?       @map("payment_method")
  initiatedAt               DateTime      @default(now()) @map("initiated_at") @db.Timestamptz
  confirmedAt               DateTime?     @map("confirmed_at") @db.Timestamptz
  providerResponseReference String?       @map("provider_response_reference")
  recordedById              String?       @map("recorded_by_id") @db.Uuid
  invoice                   Invoice       @relation(fields: [invoiceId], references: [id])
  refunds                   Refund[]

  @@unique([provider, providerTransactionId])
  @@map("payments")
}

model Refund {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String    @map("payment_id") @db.Uuid
  refundReference String    @unique @map("refund_reference")
  amount          Decimal   @db.Decimal(18, 2)
  reason          String
  status          String    @default("REQUESTED")
  requestedById   String    @map("requested_by_id") @db.Uuid
  approvedById    String?   @map("approved_by_id") @db.Uuid
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  payment         Payment   @relation(fields: [paymentId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("refunds")
}

model TechnicianSettlement {
  id                   String    @id @default(uuid()) @db.Uuid
  technicianId         String    @map("technician_id") @db.Uuid
  jobId                String    @map("job_id") @db.Uuid
  eligibleLabourAmount Decimal   @map("eligible_labour_amount") @db.Decimal(18, 2)
  commissionRate       Decimal   @map("commission_rate") @db.Decimal(5, 4) // from commission configuration, never hard-coded
  technicianAmount     Decimal   @map("technician_amount") @db.Decimal(18, 2)
  companyAmount        Decimal   @map("company_amount") @db.Decimal(18, 2)
  settlementStatus     String    @default("PENDING") @map("settlement_status")
  approvedById         String?   @map("approved_by_id") @db.Uuid
  settledAt            DateTime? @map("settled_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([technicianId])
  @@map("technician_settlements")
}

// ───────── Workshop, custody and logistics ─────────

model Workshop {
  id            String               @id @default(uuid()) @db.Uuid
  name          String
  contactPerson String?              @map("contact_person")
  contactPhone  String?              @map("contact_phone")
  email         String?
  address       String?
  district      String?
  status        WorkshopStatus       @default(PENDING_APPROVAL)
  jobs          Job[]
  inspections   WorkshopInspection[]
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@map("workshops")
}

model WorkshopInspection {
  id                  String   @id @default(uuid()) @db.Uuid
  jobId               String   @map("job_id") @db.Uuid
  workshopId          String   @map("workshop_id") @db.Uuid
  receivedCondition   String   @map("received_condition")
  accessoriesReceived String?  @map("accessories_received")
  inspectionNotes     String?  @map("inspection_notes")
  inspectedById       String   @map("inspected_by_id") @db.Uuid
  inspectedAt         DateTime @default(now()) @map("inspected_at") @db.Timestamptz
  workshop            Workshop @relation(fields: [workshopId], references: [id])

  @@index([jobId])
  @@map("workshop_inspections")
}

// Custody history: never deleted.
model EquipmentMovement {
  id                String    @id @default(uuid()) @db.Uuid
  jobId             String    @map("job_id") @db.Uuid
  movementReference String    @unique @map("movement_reference")
  movementType      String    @map("movement_type")
  fromLocation      String    @map("from_location")
  toLocation        String    @map("to_location")
  releasingPersonId String    @map("releasing_person_id") @db.Uuid
  receivingPersonId String    @map("receiving_person_id") @db.Uuid
  conditionBefore   String?   @map("condition_before")
  conditionAfter    String?   @map("condition_after")
  accessories       String?
  evidenceReference String?   @map("evidence_reference")
  acknowledgedAt    DateTime? @map("acknowledged_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("equipment_movements")
}

model CollectionDeliveryOrder {
  id                      String          @id @default(uuid()) @db.Uuid
  jobId                   String          @map("job_id") @db.Uuid
  orderType               String          @map("order_type") // COLLECTION | DELIVERY
  pickupAddress           String          @map("pickup_address")
  destinationAddress      String          @map("destination_address")
  assignedPersonId        String?         @map("assigned_person_id") @db.Uuid
  status                  LogisticsStatus @default(CREATED)
  scheduledAt             DateTime?       @map("scheduled_at") @db.Timestamptz
  collectedAt             DateTime?       @map("collected_at") @db.Timestamptz
  deliveredAt             DateTime?       @map("delivered_at") @db.Timestamptz
  customerAcknowledgement Boolean         @default(false) @map("customer_acknowledgement")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("collection_delivery_orders")
}

// ───────── Inventory ─────────

model InventoryItem {
  id            String          @id @default(uuid()) @db.Uuid
  itemCode      String          @unique @map("item_code")
  itemName      String          @map("item_name")
  category      String?
  unitOfMeasure String          @default("each") @map("unit_of_measure")
  reorderLevel  Int             @default(0) @map("reorder_level")
  active        Boolean         @default(true)
  movements     StockMovement[]
  partsUsage    JobPartsUsage[]

  @@map("inventory_items")
}

model InventoryLocation {
  id           String          @id @default(uuid()) @db.Uuid
  locationName String          @map("location_name")
  locationType String          @map("location_type")
  movements    StockMovement[]

  @@map("inventory_locations")
}

// Immutable stock transactions.
model StockMovement {
  id              String                @id @default(uuid()) @db.Uuid
  inventoryItemId String                @map("inventory_item_id") @db.Uuid
  locationId      String                @map("location_id") @db.Uuid
  movementType    InventoryMovementType @map("movement_type")
  quantity        Decimal               @db.Decimal(12, 2)
  unitCost        Decimal?              @map("unit_cost") @db.Decimal(18, 2)
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id")
  performedById   String                @map("performed_by_id") @db.Uuid
  item            InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  location        InventoryLocation     @relation(fields: [locationId], references: [id])
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@index([inventoryItemId, locationId])
  @@map("stock_movements")
}

model JobPartsUsage {
  id              String        @id @default(uuid()) @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  quantityUsed    Decimal       @map("quantity_used") @db.Decimal(12, 2)
  unitCost        Decimal?      @map("unit_cost") @db.Decimal(18, 2)
  recordedById    String        @map("recorded_by_id") @db.Uuid
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@map("job_parts_usage")
}

// ───────── Warranty ─────────

model Warranty {
  id            String          @id @default(uuid()) @db.Uuid
  reference     String          @unique
  jobId         String          @map("job_id") @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  startDate     DateTime        @map("start_date") @db.Timestamptz
  endDate       DateTime        @map("end_date") @db.Timestamptz
  warrantyTerms String?         @map("warranty_terms")
  status        WarrantyStatus  @default(ACTIVE)
  job           Job             @relation(fields: [jobId], references: [id])
  customer      Customer        @relation(fields: [customerId], references: [id])
  claims        WarrantyClaim[]

  @@map("warranties")
}

model WarrantyClaim {
  id                   String   @id @default(uuid()) @db.Uuid
  warrantyId           String   @map("warranty_id") @db.Uuid
  complaintDescription String   @map("complaint_description")
  assessment           String?
  claimStatus          String   @default("SUBMITTED") @map("claim_status")
  resolution           String?
  reviewedById         String?  @map("reviewed_by_id") @db.Uuid
  warranty             Warranty @relation(fields: [warrantyId], references: [id])
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("warranty_claims")
}

// ───────── Corporate ─────────

model CorporateAccount {
  id                 String                @id @default(uuid()) @db.Uuid
  organisationName   String                @map("organisation_name")
  registrationNumber String?               @map("registration_number")
  contactPerson      String?               @map("contact_person")
  contactEmail       String?               @map("contact_email")
  contactPhone       String?               @map("contact_phone")
  billingAddress     String?               @map("billing_address")
  accountStatus      String                @default("ACTIVE") @map("account_status")
  users              CorporateUser[]
  assets             CorporateAsset[]
  contracts          MaintenanceContract[]
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@map("corporate_accounts")
}

model CorporateUser {
  id                 String           @id @default(uuid()) @db.Uuid
  corporateAccountId String           @map("corporate_account_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  permissionLevel    String           @default("MEMBER") @map("permission_level")
  account            CorporateAccount @relation(fields: [corporateAccountId], references: [id])

  @@unique([corporateAccountId, userId])
  @@map("corporate_users")
}

model CorporateAsset {
  id                 String           @id @default(uuid()) @db.Uuid
  corporateAccountId String           @map("corporate_account_id") @db.Uuid
  assetName          String           @map("asset_name")
  category           String?
  brand              String?
  model              String?
  serialNumber       String?          @map("serial_number")
  location           String?
  assetStatus        String           @default("IN_SERVICE") @map("asset_status")
  account            CorporateAccount @relation(fields: [corporateAccountId], references: [id])

  @@map("corporate_assets")
}

model MaintenanceContract {
  id                 String           @id @default(uuid()) @db.Uuid
  corporateAccountId String           @map("corporate_account_id") @db.Uuid
  reference          String           @unique
  serviceScope       String           @map("service_scope")
  contractValue      Decimal?         @map("contract_value") @db.Decimal(18, 2)
  startDate          DateTime         @map("start_date") @db.Timestamptz
  endDate            DateTime         @map("end_date") @db.Timestamptz
  status             String           @default("ACTIVE")
  account            CorporateAccount @relation(fields: [corporateAccountId], references: [id])

  @@map("maintenance_contracts")
}

// ───────── Communication and governance ─────────

model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  message          String
  notificationType String    @map("notification_type")
  deliveryChannel  String    @default("IN_APP") @map("delivery_channel")
  deliveryStatus   String    @default("PENDING") @map("delivery_status")
  readAt           DateTime? @map("read_at") @db.Timestamptz
  user             User      @relation(fields: [userId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, readAt])
  @@map("notifications")
}

// Must be protected against ordinary modification and deletion (restrict DB grants in production).
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
